\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{luamathaccents}%
  [2026/07/26 v1.0 Unicode combining accents in math input (LuaTeX)]
\RequirePackage{iftex}
\RequireLuaTeX
\directlua{require("luamathaccents")}
\newcommand*\LuaMathAccentsOn{\directlua{luamathaccents.enable()}}
\newcommand*\LuaMathAccentsOff{\directlua{luamathaccents.disable()}}
\LuaMathAccentsOn
\endinput
